{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-agent.local/schemas/storyboard.schema.json",
  "title": "Storyboard",
  "description": "storyboard.json — danh sách scene/shot, thoại, hình minh hoạ, thời lượng, provider dự kiến (brief §7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "created_at", "language", "aspect_ratio", "scenes"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "language": { "type": "string", "minLength": 2 },
    "aspect_ratio": { "enum": ["9:16", "16:9", "1:1"] },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "role", "shots"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$" },
        "title": { "type": "string", "minLength": 1 },
        "role": { "enum": ["hook", "body", "proof", "cta"] },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shot" }
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "duration_sec",
        "narration_vi",
        "on_screen_text",
        "broll",
        "provider_hint",
        "subtitle"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$" },
        "order": { "type": "integer", "minimum": 0 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
        "narration_vi": { "type": "string", "minLength": 1 },
        "on_screen_text": {
          "type": "array",
          "items": { "$ref": "#/$defs/onScreenText" }
        },
        "broll": { "$ref": "#/$defs/broll" },
        "provider_hint": { "type": "string" },
        "subtitle": { "type": "boolean" },
        "narration_audio_asset_id": {
          "anyOf": [{ "type": "string" }, { "type": "null" }],
          "description": "ID tài sản audio đã duyệt. Có giá trị thì pipeline bỏ qua TTS và dùng đúng file đó."
        }
      }
    },
    "onScreenText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "kind", "start_offset_sec", "exact"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["phone", "price", "legal", "cta", "generic"] },
        "start_offset_sec": { "type": "number", "minimum": 0 },
        "duration_sec": {
          "anyOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }]
        },
        "exact": {
          "type": "boolean",
          "description": "true = chuỗi phải do composer chèn, không giao model sinh video vẽ (brief §D04.2)."
        }
      }
    },
    "broll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["none", "local_asset", "vimax", "video_api"] },
        "asset_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "prompt_vi": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "notes": { "type": "string" }
      }
    }
  }
}
