# =============================================================
# AI-VIDEO-AGENT — mẫu biến môi trường
# CHỈ chứa TÊN biến và giá trị GIẢ. Không bao giờ điền key thật
# vào file này. Copy sang `.env` (đã nằm trong .gitignore) để dùng.
# =============================================================

# --- Thư mục dữ liệu runtime (ngoài repo Git) ---
AIVA_RUNTIME_DIR=F:\AI-VIDEO-AGENT-RUNTIME

# --- Chế độ provider: mock | real  (mặc định mock) ---
AIVA_PROVIDER_MODE=mock

# --- Khoá an toàn chi phí: 0 = chặn mọi API tính tiền (mặc định) ---
AIVA_ALLOW_PAID_APIS=0

# --- VieNeu-TTS (D02) — chạy CPU/ONNX để né xung đột GPU với Duix ---
AIVA_VIENEU_DEVICE=cpu
AIVA_VIENEU_SAMPLE_RATE=48000

# --- Duix-Avatar (D03) — HTTP adapter tới container local ---
AIVA_DUIX_BASE_URL=http://127.0.0.1:8383
AIVA_DUIX_TIMEOUT_SEC=900

# --- FFmpeg (D04) ---
AIVA_FFMPEG_BIN=ffmpeg
AIVA_FFPROBE_BIN=ffprobe

# --- ViMax / Video API tính tiền (D05, mặc định TẮT) ---
# Giá trị dưới đây là GIẢ, chỉ để minh hoạ tên biến.
AIVA_VIDEO_API_PROVIDER=none
AIVA_VIDEO_API_KEY=REPLACE_ME_DO_NOT_COMMIT
AIVA_VIDEO_API_BASE_URL=https://example.invalid/v1
AIVA_VIDEO_API_MAX_USD_PER_RUN=0
